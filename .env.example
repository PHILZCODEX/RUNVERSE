# SUPABASE INTEGRATION (Optional - Built-in autonomous mock data works out-of-the-box)
# Create a Supabase project at https://supabase.com and run supabase/schema.sql
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# AI INTEGRATION (Optional - Local academic engine works out-of-the-box)
# Get a Google Gemini API Key from https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your-gemini-api-key-here

# Alternative OpenAI API Key
# VITE_OPENAI_API_KEY=your-openai-api-key-here

